# Environment variables (do not commit real secrets)

# Required for intake form email: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where intake submissions are delivered (default: info@candlelightfs.com)
# INTAKE_NOTIFICATION_TO=info@candlelightfs.com

# "From" address — must use a domain verified in Resend (see README).
# Example after DNS: Candlelight Financial Solutions <intake@candlelightfs.com>
# INTAKE_FROM_EMAIL=
